rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function active() { return request.auth != null && exists(/databases/$(database)/documents/staff/$(request.auth.uid)) && get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.get('active', true) == true; }
  function manager() { return active() && get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role == 'manager'; }
  match /staff/{uid} { allow get: if manager() || (active() && uid == request.auth.uid && !resource.data.keys().hasAny(['sharedLeaderboard'])); allow list: if manager(); }
  match /tasks/{id} { allow read: if manager(); }
  match /submissions/{id} { allow read: if active() && (resource.data.staffUid == request.auth.uid || manager()); match /{history}/{entry} { allow read: if manager(); } }
  match /manager_checklists/{id} { allow read: if manager(); match /history/{entry} { allow read: if manager(); } }
  match /pointTransactions/{id} { allow read: if manager() || (active() && resource.data.staffUid == request.auth.uid); }
  match /auditLogs/{id} { allow read: if manager(); }
  match /photoMetadata/{id} { allow read: if manager(); }
  match /{document=**} { allow write: if false; }
 }
}
